# Public (exposed to the browser) — must be prefixed with VITE_
VITE_APP_URL="http://localhost:3000"
VITE_API_URL="https://dummyjson.com"
VITE_APP_NAME="ViraStack Start - TanStack Edition"

# Server-only (never exposed to the browser)
# NODE_ENV is set automatically by Vite — no need to define it here.

# GitHub GraphQL için kişisel token (sadece sunucuda okunur)
GITHUB_TOKEN=""
# Supabase Postgres bağlantısı: yalnızca gitscout şemasına yetkili gitscout_app rolü, transaction pooler (6543).
# Biçim: postgresql://gitscout_app.<proje-ref>:<şifre>@<pooler-host>:6543/postgres?sslmode=require
DATABASE_URL=""
