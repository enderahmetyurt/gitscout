# Public (exposed to the browser) — must be prefixed with VITE_
VITE_APP_URL="http://localhost:3000"
VITE_APP_NAME="Gitscout"

# Server-only (never exposed to the browser)
# NODE_ENV is set automatically by Vite — no need to define it here.

# GitHub GraphQL için kişisel token (sadece sunucuda okunur)
GITHUB_TOKEN=""
# Supabase Postgres bağlantısı: yalnızca gitscout şemasına yetkili gitscout_app rolü, transaction pooler (6543).
# Biçim: postgresql://gitscout_app.<proje-ref>:<şifre>@<pooler-host>:6543/postgres?sslmode=require
DATABASE_URL=""

# Haftalık yenileme işinin rolü (gitscout_refresher): yalnızca okuma ve ham veriyi güncelleme. Biçim DATABASE_URL ile aynı.
REFRESH_DATABASE_URL=""
# Zamanlanmış yenileme adresini koruyan rastgele anahtar. Vercel'de aynı adla tanımlanınca Cron istekleri bunu gönderir.
CRON_SECRET=""

# GitHub ile giriş: Supabase Auth yalnızca sunucuda OAuth aracısı olarak kullanılır. VITE_ öneki almaz, tarayıcıya gitmez.
# Supabase panelinde Project Settings → API: proje adresi ve publishable anahtar. service_role anahtarı kullanılmaz.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
